# ============================================================
# Founder Buddy - Environment Variables Template
# ============================================================
# Copy this file to .env and fill in your values.
# The application will migrate these credentials into its
# encrypted SQLite database on first startup, then delete
# this .env file for security.
# ============================================================

# -- Server Configuration --
# Host binding: use 0.0.0.0 for Docker, 127.0.0.1 for local
HOST=127.0.0.1
PORT=8080

# -- CORS Configuration (optional) --
# Comma-separated list of allowed origins for cross-origin requests.
# Leave empty to use default localhost origins.
# ALLOWED_ORIGINS=https://your-domain.com,https://app.your-domain.com

# -- Gemini AI Configuration --
# Required: your Gemini API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: override the default Gemini model
# GEMINI_MODEL_NAME=gemini-3.5-flash-lite

# -- Microsoft Azure AD (for Microsoft Graph API) --
# Required for Teams and Outlook data ingestion
AZURE_TENANT_ID=your_tenant_id_here
AZURE_CLIENT_ID=your_client_id_here
AZURE_CLIENT_SECRET=your_client_secret_here

# -- Security (Production Only) --
# Optional: Provide a pre-generated Fernet encryption key for Docker/cloud deployments.
# Generate once with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ENCRYPTION_KEY=your_fernet_key_here

# -- Graph API (optional overrides) --
# GRAPH_API_BASE_URL=https://graph.microsoft.com/v1.0
# GRAPH_SCOPE=https://graph.microsoft.com/.default

# -- Logging --
# LOG_LEVEL=INFO
